<?xml version="1.0"?>
<robot name="ros2_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================================================= -->
  <!-- 1. PROPERTIES (BASED ON YOUR MEASUREMENTS) -->
  <!-- ======================================================= -->
  <xacro:property name="M_PI" value="3.1415926535897931"/>

  <!-- Base Dimensions -->
  <xacro:property name="base_radius" value="0.16" />       <!-- 32 cm Diameter / 2 -->
  <xacro:property name="base_height" value="0.05" />        <!-- Arbitrary, for visualization -->
  
  <!-- Wheel Properties (from Python node: WHEEL_DIAM=0.065, WHEEL_BASE=0.20) -->
  <xacro:property name="wheel_diameter" value="0.065" />
  <xacro:property name="wheel_radius" value="${wheel_diameter/2.0}" /> 
  <xacro:property name="wheel_width" value="0.02" />        <!-- Arbitrary wheel thickness -->
  <xacro:property name="wheel_separation" value="0.22" />   <!-- Distance between wheel centers -->
  
  <!-- Sensor Properties -->
  <xacro:property name="sensor_z_offset" value="0.09" />   <!-- 9 cm up from ground -->
  <xacro:property name="caster_x_offset" value="0.12" />    <!-- 12 cm forward -->
  
  <!-- Mass/Inertia properties (simple placeholders, essential for physics) -->
  <xacro:property name="base_mass" value="1.0" />
  <xacro:property name="wheel_mass" value="0.1" />


  <!-- ======================================================= -->
  <!-- 2. MACROS (Reusable Geometry Definitions) -->
  <!-- ======================================================= -->

  <!-- Macro for the wheel geometry and inertia -->
  <xacro:macro name="wheel_geometry">
    <geometry>
      <!-- Cylinder rotated 90 degrees around Y-axis to stand up -->
      <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
    </geometry>
    <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/> 
  </xacro:macro>
  
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}" />
  </xacro:macro>

  <!-- Macro for the caster wheel (sphere visualization) -->
  <xacro:macro name="caster_geometry">
    <geometry>
      <sphere radius="0.01"/>
    </geometry>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:macro>

  <!-- ======================================================= -->
  <!-- 3. BASE LINK (The core of the robot) -->
  <!-- ======================================================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <!-- Visualize the cylindrical base -->
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <origin xyz="0 0 ${wheel_radius + base_height/2.0}" rpy="0 0 0"/>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
    
    <collision>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>
      <origin xyz="0 0 ${wheel_radius + base_height/2.0}" rpy="0 0 0"/>
    </collision>
    
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <!-- Use cylinder_inertia macro -->
      <xacro:cylinder_inertia m="${base_mass}" r="${base_radius}" h="${base_height}"/>
    </inertial>
  </link>


  <!-- ======================================================= -->
  <!-- 4. DRIVE WHEELS (Left and Right) -->
  <!-- ======================================================= -->
  
  <xacro:macro name="drive_wheel" params="prefix parent reflect_y">
    <link name="${prefix}_wheel_link">
      <visual>
        <xacro:wheel_geometry/>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <xacro:wheel_geometry/>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>

    <!-- Joint connecting the wheel to the base -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${prefix}_wheel_link"/>
      <!-- The wheels are placed wheel_separation/2 from the center of the base,
           and are resting on the ground (at z=wheel_radius) -->
      <origin xyz="0 ${reflect_y * wheel_separation/2.0} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/> <!-- Rotation around the Y-axis -->
    </joint>

    <!-- ROS 2 Control (Required for Gazebo, good practice for Nav2) -->
    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <!-- Instantiate the wheels -->
  <xacro:drive_wheel prefix="left" parent="base_link" reflect_y="1"/>
  <xacro:drive_wheel prefix="right" parent="base_link" reflect_y="-1"/>


  <!-- ======================================================= -->
  <!-- 5. CASTER WHEEL -->
  <!-- ======================================================= -->
  <link name="caster_link">
    <visual>
      <xacro:caster_geometry/>
      <material name="red">
        <color rgba="0.8 0.0 0.0 1.0"/>
      </material>
    </visual>
    <collision>
      <xacro:caster_geometry/>
    </collision>
    <!-- Mass can be very small for a caster that just rolls -->
    <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <!-- Positioned forward by caster_x_offset, and on the ground -->
    <origin xyz="${caster_x_offset} 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>


  <!-- ======================================================= -->
  <!-- 6. SENSOR LINKS (IMU and Lidar) -->
  <!-- ======================================================= -->
  
  <!-- IMU Link -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- IMU positioned at the center of the base, 9cm up from the ground (wheel_radius = 3.25cm, base_height/2 = 2.5cm) -->
    <origin xyz="0 0 ${sensor_z_offset}" rpy="0 0 0"/>
  </joint>

  <!-- Laser Scanner (Lidar) Link -->
  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <!-- Laser positioned at the center of the base, 9cm up from the ground -->
    <origin xyz="0 0 ${sensor_z_offset}" rpy="0 0 0"/>
  </joint>
  
  <!-- Add a gazebo material reference for the laser link (optional) -->
  <gazebo reference="laser_link">
    <material>Gazebo/Red</material>
  </gazebo>
  
</robot>
